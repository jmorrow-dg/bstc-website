# Public entry points. Leave empty until destinations have been tested.
# WhatsApp: use the approved registration URL AFTER its thank-you page is updated.
# Do not put the private WhatsApp invite into this public repository.
NEXT_PUBLIC_BSTC_WHATSAPP_JOIN_URL=
NEXT_PUBLIC_BSTC_TELEGRAM_URL=
NEXT_PUBLIC_BSTC_UPDATES_URL=

# Server-only Resend credentials. Store actual values in hosting secret settings.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
# Legacy deployments can use RESEND_AUDIENCE_ID instead of RESEND_SEGMENT_ID.
