# --- Lead capture (Beehiiv is the system of record for all leads) ---
# Beehiiv API key: beehiiv.com → Settings → Integrations → API
BEEHIIV_API_KEY=

# Publication ID (starts with "pub_"): same API settings page
BEEHIIV_PUBLICATION_ID=

# Optional: webhook for instant lead notifications (high-priority leads,
# contact messages, sponsor/investor/startup inquiries). Works with a Slack
# incoming webhook URL or a Zapier/Make catch hook.
LEAD_NOTIFICATION_WEBHOOK_URL=
