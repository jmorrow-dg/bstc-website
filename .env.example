# Server-only Google Sheets configuration. Keep actual credentials in Vercel.
# Enable Google Sheets API and share the private spreadsheet with this service
# account as Editor. See docs/google-sheets-signups.md for the setup steps.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Signups
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM private key as a hosting secret; literal \n is supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Server-only invitations. Returned only after a confirmed signup save.
# Leave blank until each destination has been created and tested.
BSTC_WHATSAPP_INVITE_URL=
BSTC_TELEGRAM_URL=
BSTC_UPDATES_URL=
