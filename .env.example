# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
# The member hub runs fine locally WITHOUT these (member writes are skipped and logged;
# Airtable-backed resource pages show an empty "coming soon" state).

# --- Member capture: each signup is written to BOTH stores for redundancy ---
# 1) Google Sheet (Lachlan's copy) via a Google Apps Script Web App.
#    In your Sheet: Extensions > Apps Script, add:
#      function doPost(e){var s=SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
#      var d=JSON.parse(e.postData.contents);
#      s.appendRow([new Date(),d.email,d.fullName,d.whatsapp,d.linkedin,d.location,d.companyStage,d.openTo,d.interests,d.building,d.source]);
#      return ContentService.createTextOutput(JSON.stringify({ok:true}));}
#    Deploy > New deployment > Web app > Execute as: me, Access: Anyone. Paste the /exec URL:
GOOGLE_SHEET_WEBHOOK_URL=

# 2) Airtable (Josh's copy). Token scope: data.records:read + data.records:write on the base.
#    Token: https://airtable.com/create/tokens   Base ID (starts "app..."): https://airtable.com/api
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_MEMBERS_TABLE=Members
#    Members table columns (exact names): Full Name, Email address (upsert key),
#    WhatsApp Number (with country code), LinkedIn Profile URL, Location, Company Stage,
#    What are you open to right now?, Interests, What are you building?
#    A column missing in Airtable is dropped automatically; the rest of the record still saves.

# --- WhatsApp rooms (Community sub-groups), shown to members after signup ---
# The main chat is full at WhatsApp's 1,024-member cap; growth happens through
# segmented rooms under one WhatsApp Community. Create each sub-group in the
# BSTC Community, then paste its invite link here (Group info > Invite via link).
# A room appears on /members automatically once its link is set; unset rooms are
# hidden. With none set, members see the single community-wide invite instead.
WA_INVITE_INTROS=
WA_INVITE_FOUNDERS=
WA_INVITE_AI=
WA_INVITE_INVESTORS=
WA_INVITE_JOBS=
WA_INVITE_CANGGU=
WA_INVITE_UBUD=

# --- Member resource hub: rendered LIVE from Airtable (SME experts edit this base) ---
AIRTABLE_RESOURCES_TABLE=Resources
#    Resources table columns: Title, Category (single select: "Community Resource" | "Bali Guide" | "Legal & Setup"),
#    Description, URL, Contributor, Tags, Published (checkbox). Only Published=TRUE rows render.

# --- Newsletter footer form (optional, separate from member capture) ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
